// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Los "status" siguen siendo String y no enum de Postgres a propósito: la fuente de
// verdad es RequestStatus en src/lib/constants.ts (de ahí salen también las etiquetas
// de la UI) y Zod ya los valida en cada escritura. Un enum en la base duplicaría esa
// lista y obligaría a una migración por cada estado nuevo.
// Las fotos de producto siguen en su propia tabla (no String[]) porque necesitan orden.

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  description  String
  categoryId   String
  category     Category       @relation(fields: [categoryId], references: [id])
  images       ProductImage[]
  priceVisible Boolean        @default(true)
  price        Decimal?       @db.Decimal(12, 2)
  isActive     Boolean        @default(true)
  viewCount    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  order     Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ServiceType {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  hasFixedPrice Boolean          @default(false)
  fixedPrice    Decimal?         @db.Decimal(12, 2)
  description   String
  isActive      Boolean          @default(true)
  requests      ServiceRequest[]
}

// NOTA: clientPhone/clientEmail se guardan cifrados (AES-256-GCM, src/lib/crypto.ts).
// Los campos *Index son HMAC determinísticos para poder buscar sin descifrar la tabla.
model ServiceRequest {
  id                String      @id @default(cuid())
  serviceTypeId     String
  serviceType       ServiceType @relation(fields: [serviceTypeId], references: [id])
  status            String      @default("PENDIENTE")
  clientName        String
  clientPhone       String
  clientPhoneIndex  String?
  clientEmail       String?
  clientEmailIndex  String?
  description       String
  referenceImageUrl String?
  quotedPrice       Decimal?    @db.Decimal(12, 2)
  adminNotes        String?
  createdAt         DateTime    @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([clientPhoneIndex])
  @@index([clientEmailIndex])
}

model GoldPurchaseRequest {
  id                String   @id @default(cuid())
  status            String   @default("PENDIENTE")
  clientName        String
  clientPhone       String
  clientPhoneIndex  String?
  description        String
  referenceImageUrl String?
  offeredPrice      Decimal? @db.Decimal(12, 2)
  adminNotes        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([clientPhoneIndex])
}

model AdminUser {
  id           String              @id @default(cuid())
  name         String?
  email        String              @unique
  passwordHash String
  // Marca de tiempo del último cambio de contraseña. Las sesiones son JWT (no
  // hay tabla de sesiones que borrar), así que se comparan contra este valor
  // para poder invalidarlas al cambiar la contraseña.
  passwordChangedAt DateTime       @default(now())
  resetTokens  PasswordResetToken[]
}

// Se guarda solo el hash del token: si alguien lee la tabla, no puede
// reconstruir el link de reseteo que se mandó por email.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String
  entityType String
  entityId   String
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
