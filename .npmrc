# next-auth declara peerOptional nodemailer ^7||^8, pero fijamos >=9.0.4 para
# parchear GHSA-p6gq-j5cr-w38f (8.x es vulnerable). Solo usamos el provider de
# Credentials, nunca el de Email, así que el conflicto es inerte.
# Sin esto, `npm install` falla acá y en el build de Render.
legacy-peer-deps=true
