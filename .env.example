# Plantilla de variables de entorno. Copiar a `.env` y completar.
# NUNCA poner valores reales acá: este archivo SÍ se versiona en git.
# El `.env` real está en .gitignore y no debe subirse nunca.

# Base de datos Postgres (Prisma Postgres / Neon / Supabase).
# uselibpqcompat=true hace que el driver valide el certificado TLS del servidor.
DATABASE_URL="postgres://usuario:clave@host:5432/base?sslmode=require&uselibpqcompat=true"

# Firma de las sesiones de administración.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Clave AES-256 (32 bytes en base64) que cifra los datos de clientes en la base:
# nombre, teléfono, email, el texto de la solicitud y las notas internas.
# Generar con: openssl rand -base64 32
#
# ⚠️ SE GENERA UNA SOLA VEZ Y NO SE CAMBIA NUNCA MÁS.
# Todos los entornos (tu .env local y el del despliegue) tienen que tener
# EXACTAMENTE el mismo valor. Si no coinciden, lo que guarda uno queda ilegible
# para el otro y no se recupera: AES-GCM sin la clave correcta no abre.
# También rompe en silencio la búsqueda por teléfono y email, porque los índices
# ciegos se derivan de esta misma clave.
#
# Guardala aparte (gestor de contraseñas) el día que la generes.
# Para comprobar que este entorno tiene la correcta: npm run check:key
ENCRYPTION_KEY=""

# WhatsApp del negocio en formato E.164 sin "+".
WHATSAPP_NUMBER="595900000000"

# URL pública del sitio. De esto depende que el link de la foto que se manda
# por WhatsApp le abra al negocio, así que en producción debe ser el dominio real.
SITE_URL="http://localhost:3000"

# URL pública para Auth.js — debe coincidir con SITE_URL.
# Sin esto, detrás de un proxy los redirects del login van al puerto interno.
AUTH_URL="http://localhost:3000"

# SMTP para los emails de recuperación de contraseña.
# Si queda vacío, el enlace se imprime en la consola del servidor en vez de enviarse.
# Gmail requiere una "contraseña de aplicación" (con verificación en 2 pasos activada),
# y que SMTP_FROM sea la misma cuenta autenticada.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Cloudinary: almacenamiento permanente de las fotos.
# Sin esto, las imagenes van al disco local y se BORRAN en cada despliegue.
# Los valores estan en el Dashboard de Cloudinary (Product Environment Credentials).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend: envio de correo por HTTPS. Necesario en Render, que bloquea el SMTP
# saliente (la conexion se cuelga y el mail nunca sale).
# Si esta definida, se usa en lugar de SMTP. Con el plan gratuito y sin dominio
# propio, Resend solo permite enviar a la casilla con la que te registraste.
RESEND_API_KEY=""
RESEND_FROM="onboarding@resend.dev"
